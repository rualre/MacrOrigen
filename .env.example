# PostgreSQL (Neon/Supabase). No es necesaria para el demo local.
DATABASE_URL="postgresql://usuario:password@host:5432/macrorigen?sslmode=require"

# Obligatoria en producción. Generar con: openssl rand -base64 48
# En este equipo se creó automáticamente en .env.local (archivo ignorado por Git).
AUTH_SECRET=""

# Precio mostrado por el checkout local de demostración. No procesa cobros reales.
SUBSCRIPTION_PRICE_COP="29900"
# No habilitar salvo en entornos de demostración deliberados. Localhost no la necesita.
ALLOW_DEMO_CHECKOUT="false"

# Opcionales: caché y rate limiting distribuido.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Opcionales: active uno o varios proveedores. Nunca usar prefijo NEXT_PUBLIC_.
GOOGLE_GENERATIVE_AI_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""

# Modelos configurables según disponibilidad de su cuenta.
GEMINI_MODEL="gemini-2.0-flash"
GROQ_MODEL="llama-3.3-70b-versatile"
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"

# Separadas por comas; rotación round-robin por proceso.
# GOOGLE_GENERATIVE_AI_API_KEYS="key1,key2"
